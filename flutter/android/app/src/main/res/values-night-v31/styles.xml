<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always show a system launch screen. It can only show a colour, so it
         shows no icon and the home scene's dusk colour the blurred still then fades in over. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/home_dusk</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

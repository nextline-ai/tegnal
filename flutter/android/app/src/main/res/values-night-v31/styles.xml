<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always show a system launch screen. It shows no icon, only the
         background the TEGNAL artwork appears on, as the native app's launch screen is empty. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <!-- Chosen at run time on Android 13 and later to follow the app's own appearance. -->
    <style name="LaunchTheme.Light">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
    </style>

    <style name="LaunchTheme.Dark">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

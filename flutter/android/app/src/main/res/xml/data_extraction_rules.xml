<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the library eligible for OS backup without transferring browser data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="drive-sync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="drive-sync/" />
    </device-transfer>
</data-extraction-rules>

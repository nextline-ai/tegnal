<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window before Android 12: the dusk colour with the home scene's blurred still over it.
     The picture is a blur, so stretching it to a phone-shaped screen is not noticeable;
     tablets use the colour alone (drawable-sw600dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/home_dusk" />
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/home_blur" />
    </item>
</layer-list>

migrate_working_dir/

# Editor settings
*.iml
*.ipr
*.iws
.idea/

# Private design originals; runtime and documentation assets have separate terms.
/design/

# Native Xcode build output and local settings
**/DerivedData/
**/xcuserdata/

# Violet source dumps and local databases — never commit
/user_data/
/user.db
/data.db
*.db
*.db-wal
*.db-journal
*.db-shm

# Local GitHub CLI configuration
/.gh-config/

# Credentials, signing material, and local test/export artifacts
.env
.env.*
!.env.example
*.p12
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.xcresult/
*.xcarchive/
*.ipa

# Local tool configuration and generated Python caches
/.codex/
/.github/*
# README images live in .github/assets/. The desktop builds run on GitHub Actions, so only their workflow is kept.
!/.github/assets/
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/flutter-desktop-builds.yml
__pycache__/

# Brand originals; README images live in .github/assets/
/design-output/

# Local OCR benchmark harness for comic translation (kept out of the repository)
/native-ios/scripts/ocr-bench/

# Kept on this Mac, never published: all documentation and agent notes (index: docs/README.md),
# and files taken out of the repository.
/docs/
/CLAUDE.md
/AGENTS.md
/archive/

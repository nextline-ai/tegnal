# Common generated files
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Editor settings
*.iml
*.ipr
*.iws
.idea/

# Private design originals; runtime and documentation assets have separate terms.
/design/

# Native Xcode build output and local settings
**/DerivedData/
**/xcuserdata/

# Violet source dumps and local databases — never commit
/user_data/
/user.db
/data.db
*.db
*.db-wal
*.db-journal
*.db-shm

# Local GitHub CLI configuration
/.gh-config/

# Credentials, signing material, and local test/export artifacts
.env
.env.*
!.env.example
*.p12
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.xcresult/
*.xcarchive/
*.ipa

# Local tool configuration and generated Python caches
/.codex/
__pycache__/

# Local research and working records; GitHub Pages publishes all of docs/
/research/
/docs/app-store-review.md
/docs/challenge-example.json
/docs/challenges/
/docs/google-play/
/docs/implementation/
/flutter/docs/android-beta*-validation.md
/flutter/docs/android-play-bundle-*.md
/flutter/docs/android-release-1.0.0-beta.*.md
/flutter/docs/flutter-*-validation.md

# Only repository-referenced brand assets are published
/design-output/*
!/design-output/JPG/
/design-output/JPG/*
!/design-output/JPG/symbol.jpg
!/design-output/SVG/
/design-output/SVG/*
!/design-output/SVG/button/
!/design-output/screenshot/
/design-output/screenshot/*
!/design-output/screenshot/info.webp
